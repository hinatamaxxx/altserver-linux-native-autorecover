# 日本語:
# このファイルを Debian 上の /etc/altserver-native.env にコピーして使います。
# 実際の /etc/altserver-native.env は GitHub にコミットしないでください。
#
# English:
# Copy this file to /etc/altserver-native.env on the Debian host.
# Do not commit the real /etc/altserver-native.env file.

# Debian のLAN IP。AltServerとして広告したいIPアドレスです。
# Debian LAN IP advertised as AltServer.
ALTSERVER_HOST_IP=<DEBIAN_LAN_IP>

# iPhone の情報。netmuxd のWi-Fi復旧に使います。
# iPhone values used for local mDNS/netmuxd recovery.
IPHONE_UDID=<IPHONE_UDID>
IPHONE_WIFI_MAC=<IPHONE_WIFI_MAC>
IPHONE_FALLBACK_IP=<IPHONE_LAN_IP>

# AltServer の配置場所。
# AltServer runtime paths.
ALTSERVER_HOME=/opt/altserver-native
ALTSERVER_BIN=/opt/altserver-native/bin/AltServer
NETMUXD_BIN=/opt/altserver-native/bin/netmuxd

# AltServer が接続する netmuxd のTCP mux。
# netmuxd TCP mux listener used by AltServer.
USBMUXD_SOCKET_ADDRESS=127.0.0.1:27015

# AltServer-Linux v0.0.5-rc1 のリリースノートにあるWi-Fi refresh用の回避策。
# Wi-Fi refresh workaround mentioned in AltServer-Linux v0.0.5-rc1.
ALTSERVER_NO_SUBSCRIBE=1

# anisette サーバー。
# native anisette が動くならローカルnativeでもOKです。
# native anisette が動かない場合は Docker 版を使います。
# Anisette service.
# Use native anisette if it works. Use Docker compatibility if native anisette is incompatible.
ALTSERVER_ANISETTE_SERVER=http://127.0.0.1:6969
ANISETTE_URL=http://127.0.0.1:6969/

# Docker版 anisette の設定。
# デフォルトでは単体起動できる anisette-v3-server を使います。
# Docker compatibility settings.
# The default image can run standalone.
ANISETTE_DOCKER_IMAGE=dadoum/anisette-v3-server:latest
ANISETTE_DOCKER_VOLUME=altserver-anisette-data
