#!/bin/sh
set -eu
set -a
. "${ENV_FILE:-/etc/altserver-native.env}"
set +a

state="${ALTSERVER_HEALTH_STATE_DIR:-/run/altserver-native-health}"
install -d -m 0700 "$state"
exec 9>"$state/lock"
flock -n 9 || exit 75
probe="${ALTSERVER_PROBE:-/usr/local/sbin/altserver-native-probe}"

log() { logger -t altserver-health "$*"; printf '%s\n' "$*"; }
reset() { rm -f "$state/$1.failures"; }
recover() {
  component="$1"
  unit="$2"
  failures=0
  if [ -f "$state/$component.failures" ]; then
    read -r failures <"$state/$component.failures"
  fi
  failures=$((failures + 1))
  printf '%s\n' "$failures" >"$state/$component.failures"
  if [ "$failures" -lt 3 ]; then
    log "$component check failed ($failures/3); waiting for confirmation"
    return 0
  fi
  last=0
  if [ -f "$state/$component.restarted" ]; then
    read -r last <"$state/$component.restarted"
  fi
  now="$(date +%s)"
  if [ "$((now - last))" -lt 300 ]; then
    log "$component recovery cooldown active"
    return 0
  fi
  printf '%s\n' "$now" >"$state/$component.restarted"
  log "recovering $component after repeated failures"
  systemctl restart "$unit"
}

unhealthy=0
if "$probe" anisette; then
  reset anisette
else
  recover anisette altserver-anisette-docker.service
  unhealthy=1
fi

# Check the server even when the phone is asleep or away.
if systemctl is-active --quiet altserver-native.service && "$probe" altserver; then
  reset altserver
else
  recover altserver altserver-native.service
  unhealthy=1
fi

if ! systemctl is-active --quiet altserver-native-netmuxd.service || ! "$probe" query; then
  recover netmux altserver-native-netmuxd.service
  exit 1
fi
reset netmux

if ! current_ip="$("$probe" discover)"; then
  log "waiting_for_device: configured iPhone is unavailable; infrastructure checked"
  if [ "$unhealthy" -ne 0 ]; then exit 1; fi
  exit 2
fi

if ! "$probe" network; then
  log "re-registering the configured iPhone without restarting netmuxd or AltServer"
  if ! "$probe" register "$current_ip"; then
    log "waiting_for_pairing: network registration/heartbeat unavailable; unlock iPhone and check USB trust"
    if [ "$unhealthy" -ne 0 ]; then exit 1; fi
    exit 2
  fi
fi

if [ "$unhealthy" -ne 0 ]; then
  log "degraded: recovery pending; no healthy result claimed"
  exit 1
fi
log "healthy"
