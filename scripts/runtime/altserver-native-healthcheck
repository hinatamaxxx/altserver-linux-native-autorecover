#!/bin/sh
set -eu

. /etc/altserver-native.env

log() {
  logger -t altserver-health "$*"
  echo "$*"
}

anisette_ok() {
  headers="$(mktemp)"
  body="$(mktemp)"
  if curl -fsS --max-time 5 -D "$headers" "$ANISETTE_URL" -o "$body" &&
     grep -qi '^Content-Type: application/json' "$headers"; then
    rm -f "$headers" "$body"
    return 0
  fi
  rm -f "$headers" "$body"
  return 1
}

iphone_port_ok() {
  nc -z -w 4 "$IPHONE_FALLBACK_IP" 62078 >/dev/null 2>&1
}

netmux_has_network_device() {
  python3 - "$IPHONE_UDID" <<'PY'
import json
import plistlib
import socket
import struct
import sys

udid = sys.argv[1]
payload = {
    "MessageType": "ListDevices",
    "ClientVersionString": "altserver-health",
    "ProgName": "altserver-health",
    "kLibUSBMuxVersion": 3,
}
body = plistlib.dumps(payload, fmt=plistlib.FMT_XML)
packet = struct.pack("<IIII", 16 + len(body), 1, 8, 1) + body
try:
    with socket.create_connection(("127.0.0.1", 27015), timeout=5) as sock:
        sock.sendall(packet)
        header = sock.recv(16)
        if len(header) != 16:
            raise RuntimeError("short header")
        length, version, msgtype, tag = struct.unpack("<IIII", header)
        data = b""
        while len(data) < length - 16:
            chunk = sock.recv(length - 16 - len(data))
            if not chunk:
                break
            data += chunk
    try:
        obj = plistlib.loads(data)
    except Exception:
        obj = json.loads(data.decode())
except Exception as exc:
    print(f"netmux query failed: {exc}", file=sys.stderr)
    raise SystemExit(1)

for dev in obj.get("DeviceList", []):
    props = dev.get("Properties", {})
    if props.get("SerialNumber") == udid and props.get("ConnectionType") == "Network":
        raise SystemExit(0)

print(obj, file=sys.stderr)
raise SystemExit(1)
PY
}

altserver_mdns_ok() {
  timeout 8 avahi-browse -rt _altserver._tcp 2>/dev/null | grep -q "address = \[$ALTSERVER_HOST_IP\]"
}

recover_anisette() {
  log "recovering anisette service"
  systemctl restart altserver-anisette-docker.service || true
  sleep 5
}

recover_netmux() {
  log "recovering netmuxd and iPhone mDNS publishers"
  systemctl restart altserver-native-netmuxd.service || true
  sleep 3
  systemctl restart iphone-mobdev-address.service iphone-mobdev-service.service || true
  sleep 8
}

recover_altserver() {
  log "recovering AltServer service"
  systemctl restart altserver-native.service || true
  sleep 8
}

if ! systemctl is-active --quiet altserver-anisette-docker.service || ! anisette_ok; then
  log "anisette unhealthy"
  recover_anisette
fi

if ! iphone_port_ok; then
  log "iPhone ${IPHONE_FALLBACK_IP}:62078 is not reachable; leaving services running"
  exit 0
fi

if ! systemctl is-active --quiet altserver-native-netmuxd.service || ! netmux_has_network_device; then
  log "netmuxd does not expose configured iPhone as Network"
  recover_netmux
fi

if ! systemctl is-active --quiet altserver-native.service || ! altserver_mdns_ok; then
  log "AltServer service or mDNS advertisement unhealthy"
  recover_altserver
fi

i=0
while [ "$i" -lt 5 ]; do
  if anisette_ok && netmux_has_network_device && altserver_mdns_ok; then
    log "healthy"
    exit 0
  fi
  i=$((i+1))
  sleep 3
done

log "still unhealthy after recovery"
exit 1
